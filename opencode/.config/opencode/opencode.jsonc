{
  "$schema": "https://opencode.ai/config.json",
  "autoupdate": true,
    "model": "openrouter/deepseek/deepseek-v4-flash-0731",
//  "model": "openrouter/deepseek/deepseek-v4-flash",
  "small_model": "openrouter/moonshotai/kimi-k2.5",
  "snapshot": false,
  "experimental": {
    "openTelemetry": false
  },
  "provider": {
    "leollama": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "LeOllama",
      "options": {
        "baseURL": "http://192.168.1.24:11434/v1"
      },
      "models": {
        "qwen3:8b": {
          "name": "qwen3:8b"
        }
      }
    }
  },
  "agent": {
    "plan": {
      "color": "info"
    }
  },
  "instructions": [
    "~/.config/opencode/instructions/caveman.md"
  ],
  "share": "disabled",
  "formatter": false,
  "mcp": {
    "playwright": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@playwright/mcp"
      ],
      "enabled": true
    },
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "headers": {
        "CONTEXT7_API_KEY": "{env:CONTEXT7_API_KEY}"
      },
      "enabled": true
    }
  },
  "lsp": true,
  "permission": {
    "ralph-tui-prd": "allow",
    "read": {
      "~/.config/opencode/get-shit-done/*": "allow",
      "~/.config/opencode/gsd-core/*": "allow"
    },
    "external_directory": {
      "~/.config/opencode/get-shit-done/*": "allow",
      "~/.config/opencode/gsd-core/*": "allow"
    }
  },
  "watcher": {
    "ignore": [
      "**/.assets/",
      "**/.build/",
      "**/.doc/sessions/",
      "**/.cache/",
      "**/.html/",
      "**/.mypy_cache/",
      "**/.pytest_cache/",
      "**/.venv/",
      "**/.vscode-server/",
      "**/__pycache__",
      "**/.coverage",
      "**/.DS_Store",
      "**/.git",
      "**/.hg",
      "**/.svn",
      "**/.vscode",
      "**/*.egg-info",
      "**/*.pyc",
      "**/CVS",
      "**/dist/",
      "**/.gnupg/",
      "**/.local/",
      "**/.ssh/",
      "**/.config/",
      "**/.streamlit",
      "**/sessions"
    ]
  }
}
