#!/bin/sh

if [ -z "$VAULT_TOKEN" ]; then
  if [ "$(hostname)" = "leona" ]; then
    VAULT_TOKEN=$(cat "$HOME/workspace/.uk")
  else
    VAULT_TOKEN=$(PATH="$HOME/.local/bin/vault-browser:$PATH" vault login -method=oidc -token-only 2>/dev/null)
  fi
  export VAULT_TOKEN
fi

exec "$HOME/.local/share/mise/shims/lazygit" "$@"
